.markdown-body {
  color: var(--theme-text-primary)

  &:before, &:after {
    content: ""
    display: table
  }

  &:after { clear: both }

  h1, h2, h3, h4, h5, h6 {
    font-weight: bold
    margin: 1em 0
  }

  h1 {
    font-size: 32px;
  }

  h1, h2 {
    font-weight: 600;
    padding-bottom: .3em;
    border-bottom: 1px solid var(--theme-border-secondary);
  }

  h2 {
    font-size: 24px;
  }

  h3 {
    font-size: 20px;
  }

  h3, h4 {
    font-weight: 600;
  }

  h4 {
    font-size: 16px;
  }

  h5 {
    font-size: 14px;
  }

  h5, h6 {
    font-weight: 600;
  }

  h6 {
    font-size: 12px;
  }
  
  p, table {
    margin: $markdown-vertical 0
  }
  
  /* 当段落后面有代码块时，设置段落底部间距为10px */
  p + pre, p + .highlight {
    margin-top: 10px;
  }
  
  /* 为与上面的规则配合，也可以修改所有p的底部间距 */
  p {
    margin-bottom: 10px;
  }
  
  p, li {
    font-size: 17px;
  }
  // li{
  //   font-weight: 500;
  // }
  
  table {
    width: 100%
    border-collapse: collapse
    border-spacing: 0
    table-layout: auto
  }

  th {
    font-weight: bold
    border-bottom: 3px solid #ddd
    padding-bottom: 0.5em
    text-align: center
    vertical-align: middle
    color: #ff69b4
  }

  td {
    border-bottom: 1px solid #ddd
    padding: 10px 5px
    text-align: center
    vertical-align: middle
  }

  hr {
    height: 0;
    margin: 15px 0;
    overflow: hidden;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--theme-border-primary);
    transition: border-color 0.3s ease;
  }
  
  a {
    text-decoration: none
    word-break: break-all
    border-bottom: 2px solid #dde0e0
    transition: border 0.3s ease
    color: var(--theme-text-active)

    &:hover {
      border-color: var(--theme-text-active)
    }
  }

  ul, ol, dl {
    margin-top: 0 !important
    margin-bottom: 0 !important
  }

  ul, ol {
    padding-left: 2em
  }

  ul { list-style-type: disc }
  
  ol { list-style-type: decimal }
  
  img, video {
    display: block
    height: auto
    margin-top: $markdown-imgvideo
    max-width: 100%;
    box-sizing: initial;
    background-color: var(--theme-bg-primary);
    soft-box(var(--soft-small-radius));
  }
  
  iframe { border: none }
    
  blockquote {
    font-family: Georgia, "Times New Roman", serif
    font-size: 1em
    color: var(--theme-text-low)
    border-left: 3px solid var(--theme-text-low)
    padding-left: 1em

    footer {
      font-size: 14px
      margin: $markdown-vertical 0
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell", "Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif

      cite:before {
        content: "—"
        padding: 0 0.5em
      }
    }
  }

  .pullquote {
    text-align: left
    width: 45%
    margin: 0

    &.left {
      margin-left: 0.5em
      margin-right: 1em
    }

    &.right {
      margin-right: 0.5em
      margin-left: 1em
    }
  }

  .caption {
    color: #999
    display: block
    font-size: 0.9em
    margin-top: 0.5em
    position: relative
    text-align: center
  }

  .video-container {
    position: relative
    padding-top: 56.25%
    height: 0
    overflow: hidden
    soft-box(var(--soft-small-radius));

    iframe, object, embed {
      position: absolute
      top: 0
      left: 0
      width: 100%
      height: 100%
      margin-top: 0
    }
  }
  
  del { color: var(--theme-text-low) }

  pre, code {
    font-family: Cascadia Code, "Source Code Pro", Consolas, Monaco, Menlo, Consolas, monospace
  }

  code {
    padding: 0 0.3em
    margin-left: 0.3em
    margin-right: 0.3em
    background-color: var(--theme-bg-shadow)
    border-radius: 3px
  }
  p code{
    color: #825ee1
  }
  
  /* 添加对列表中行内代码的样式支持 */
  li code {
    color: #825ee1
    display: inline-block
    vertical-align: middle
    background-color: var(--theme-bg-shadow)
    border-radius: 3px
    padding: 0 0.3em
    margin: 0 0.2em
  }
  
  /* 处理嵌套列表中的代码 */
  li li code {
    color: #825ee1
    display: inline-block
    vertical-align: middle
    background-color: var(--theme-bg-shadow)
    border-radius: 3px
  }

  pre code {
    background: none
    text-shadow: none
    padding: 0
    margin: 0
    color: inherit
    vertical-align: inherit
    display: inline
  }

  pre, .highlight {
    background: #2d2d2d
    overflow: auto
    color: #ccc
    padding: 10px 18px
    font-size: 14px
  }
.highlight {
    border-radius: 10px
  }
  .highlight .gutter pre, .gist .gist-file .gist-data .line-numbers {
    color: #666
    padding-right: 20px
  }

  .highlight {
    pre {
      border: none
      margin: 0
      padding: 0
    }

    table {
      margin: 0
      width: auto
      table-layout: fixed
    }

    td {
      border: none
      padding: 0
      text-align: left
      vertical-align: top
    }

    th {
      text-align: left
      vertical-align: top
    }

    .gutter pre {
      text-align: right
      padding-right: 20px
    }
  }
}

.markdown-body .aplayer.aplayer-box { /** aplayer */
  margin: 20px 0;
  background-color: var(--theme-bg-color);
  soft-box(var(--soft-small-radius));

  .aplayer-info .aplayer-controller .aplayer-time {
    line-height: normal;
  }

  .aplayer-lrc:before {
    background: linear-gradient(180deg, var(--theme-bg-color) 0, hsla(0,0%,100%,0));
  }

  .aplayer-lrc:after {
    background: linear-gradient(180deg, hsla(0,0%,100%,0) 0, var(--theme-bg-color));
  }
}

.markdown-body .dplayer.dplayer-box { /** dplayer */
  margin: 20px 0;
  soft-box(var(--soft-small-radius));
}

.markdown-body .figure-image { /** figure image */
  margin-top: 16px;
  margin-bottom: 16px;

  figcaption {
    margin-top: 12px;
    text-align: center;
    color: var(--theme-text-low);
  }
}
.article-entry p + p {
  margin-top: 10px;
}
.article-entry p:has(+ p) {
  margin-bottom: 10px;
}

/* 或者给文章内容中的标题添加 */
.article-entry h1::before, 
.article-entry h2::before, 
.article-entry h3::before, 
.article-entry h4::before,
.article-entry h5::before,
.article-entry h6::before,   {
  content: "✦ ";
  color: #333;
}
// 首行缩进
/* 给文章内容中的所有段落添加首行缩进 */
.article-entry p::before {
  content: "\2003\2003"; /* 相当于 &emsp;&emsp; */
  display: inline;
}
.article-entry pre p::before,
.article-entry blockquote p::before,
.article-entry li p::before,
.article-entry .no-indent p::before,
.article-entry p.no-indent::before {
  content: "";
}

p.katex-block::before {
  display: none !important;
  content: none !important;
}

/* 表格展开/压缩功能样式 */
.table-container {
  position: relative;
  margin: 1em 0;
}

.table-row-hidden {
  display: none !important;
}

.table-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0px;
  margin-top: 0px;
  padding: 8px 0;
}

.table-toggle-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 12px;
  background-color: var(--theme-bg-high);
  border: 1px solid var(--theme-border-primary);
  border-radius: 4px;
  color: var(--theme-text-primary);
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.3s ease;
  
  &:hover {
    background-color: var(--theme-text-active);
    color: var(--theme-text-light);
    border-color: var(--theme-text-active);
  }
  
  .toggle-icon {
    font-size: 10px;
    transition: transform 0.3s ease;
  }
}

.table-row-info {
  font-size: 12px;
  color: var(--theme-text-low);
  font-style: italic;
}

/* 表格收起状态的过渡效果 */
.table-collapsed {
  transition: all 0.3s ease;
}

/* 响应式调整 */
@media screen and (max-width: 768px) {
  .table-controls {
    flex-direction: column;
    gap: 5px;
  }
  
  .table-toggle-btn {
    font-size: 12px;
    padding: 5px 10px;
  }
  
  .table-row-info {
    font-size: 11px;
  }
}



